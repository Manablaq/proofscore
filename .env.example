# Public frontend configuration for the finalized ProofScore v9 production candidate.
# Do not point the current UI at v10 until the v10 interface and deployment proof
# are published; v9 remains independently usable during the migration.
NEXT_PUBLIC_PROOFSCORE_V9_ADDRESS=0x0a4E4cBBF682aE0EdedE09865eD0A338518976C3
# Set only after v10 is deployed and its end-to-end proof is finalized.
# NEXT_PUBLIC_PROOFSCORE_V10_ADDRESS=0x...
NEXT_PUBLIC_GENLAYER_RPC=https://rpc-bradbury.genlayer.com

# Script-only secrets belong in the shell environment, never in this file:
# GENLAYER_DEPLOYER_PK
# PROOFSCORE_V9_ADDRESS
